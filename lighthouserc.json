{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start:node",
      "startServerReadyPattern": "Server listening",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/es",
        "http://localhost:4321/legal/privacy",
        "http://localhost:4321/es/legal/privacidad",
        "http://localhost:4321/legal/credits",
        "http://localhost:4321/sign-in",
        "http://localhost:4321/es/acceso",
        "http://localhost:4321/demo",
        "http://localhost:4321/es/demo",
        "http://localhost:4321/demo/stats"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:4321/(es)?(/legal/.*)?$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "/(sign-in|es/acceso)$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "/(es/)?demo(/stats)?$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
