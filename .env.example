# Suvaro — environment variables (names only, never commit values)
# Local dev: TURSO_DATABASE_URL=file:local.db and no auth token.

# Database (Turso, EU region)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email (Resend, from suvaro.xyz)
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Cron authorization
CRON_SECRET=

# Public site URL (https://suvaro.xyz in production, http://localhost:4321 in dev)
PUBLIC_SITE_URL=
