# Suvaro — environment variables (names only, never commit values)
# Local dev needs none of them: the database is file:local.db, sign-in codes print to the console and
# Better Auth uses a development-only secret. On Vercel, mark every secret as Sensitive.

# Database (Turso, EU region)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth (Better Auth). Secret: at least 32 random characters (e.g. `openssl rand -base64 32`).
# BETTER_AUTH_URL is optional: production defaults to https://suvaro.xyz, previews to their branch URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email (Resend, from suvaro.xyz). Without a key, development prints emails to the console.
RESEND_API_KEY=
EMAIL_FROM=Suvaro <no-reply@suvaro.xyz>

# Vercel Cron authorization
CRON_SECRET=

# Public site URL (https://suvaro.xyz in production, http://localhost:4321 in dev)
PUBLIC_SITE_URL=
