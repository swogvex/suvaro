---
/**
 * Mobile floating dock (< 768 px): fixed, centered, above Safari's bottom toolbar (safe-area inset + 12 px).
 * Items 48×48: Home · Movements · Stats · Plan | + (new movement) | theme toggle.
 * Hidden while the on-screen keyboard is open.
 * @prop locale   Profile language.
 * @prop section  Active section, for `aria-current`.
 * @prop planDot  Budget alerts not read on Plan yet (a dot on the Plan item).
 */
import Icon from '../ui/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations, type Locale } from '../../i18n';
import { appSections, type AppSection } from '../../lib/app-nav';

interface Props {
  locale: Locale;
  section: AppSection | 'settings';
  planDot?: boolean;
}

const { locale, section, planDot = false } = Astro.props;
const t = useTranslations(locale);
---

<nav class="dock" aria-label={t('app.navLabel')} data-dock>
  <ul>
    {appSections.map(({ key, href, label, icon }) => (
      <li>
        <a class="dock__item" href={href} aria-current={section === key ? 'page' : undefined}>
          <Icon name={icon} />
          <span class="visually-hidden">{t(label)}</span>
          {key === 'plan' && (
            <span class="tab-dot dock__dot" data-plan-dot hidden={!planDot}>
              <span class="visually-hidden">{t('plan.alertDot')}</span>
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
  <span class="dock__sep" aria-hidden="true"></span>
  <button class="dock__item dock__new" type="button" aria-label={t('app.shortcutNew')} data-open-editor>
    <Icon name="plus" />
  </button>
  <span class="dock__sep" aria-hidden="true"></span>
  <ThemeToggle locale={locale} class="dock__item" />
</nav>

<script>
  // Hide the dock while the on-screen keyboard takes part of the viewport.
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const viewport = window.visualViewport;
  if (dock && viewport) {
    const update = () => {
      dock.dataset['keyboard'] = String(viewport.height < window.innerHeight * 0.75);
    };
    viewport.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .dock {
    position: fixed;
    inset-inline: 0;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
    z-index: 20;
    display: flex;
    gap: var(--space-1);
    align-items: center;
    width: max-content;
    max-width: calc(100% - 2 * var(--space-4));
    margin-inline: auto;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }

  .dock[data-keyboard='true'] {
    display: none;
  }

  .dock ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* :global so the theme toggle (its own component) gets the same look. */
  .dock :global(.dock__item) {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-btn);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .dock :global(.dock__item:hover) {
    background: var(--surface-2);
  }

  .dock :global(.dock__item[aria-current='page']) {
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--accent);
  }

  .dock__item {
    position: relative;
  }

  .dock__dot {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-end: 8px;
  }

  .dock :global(.dock__item svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .dock .dock__new,
  .dock .dock__new:hover {
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 2px 0 var(--accent-strong);
  }

  .dock__sep {
    align-self: stretch;
    width: 1px;
    margin-block: var(--space-2);
    background: var(--line);
  }

  @media (min-width: 48rem) {
    .dock {
      display: none;
    }
  }
</style>
