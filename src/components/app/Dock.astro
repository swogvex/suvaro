---
/**
 * Mobile floating dock (< 768 px): fixed, centered, above Safari's bottom toolbar (safe-area inset + 12 px).
 * Items 48×48: Home · Movements · Stats · Plan | theme toggle. The "+" (new movement) arrives with movements.
 * Hidden while the on-screen keyboard is open.
 * @prop locale   Profile language.
 * @prop section  Active section, for `aria-current`.
 */
import Icon from '../ui/Icon.astro';
import { useTranslations, type Locale } from '../../i18n';
import { appSections, type AppSection } from '../../lib/app-nav';

interface Props {
  locale: Locale;
  section: AppSection | 'settings';
}

const { locale, section } = Astro.props;
const t = useTranslations(locale);
---

<nav class="dock" aria-label={t('app.navLabel')} data-dock>
  <ul>
    {appSections.map(({ key, href, label, icon }) => (
      <li>
        <a
          class="dock__item"
          href={href}
          aria-label={t(label)}
          aria-current={section === key ? 'page' : undefined}
        >
          <Icon name={icon} />
        </a>
      </li>
    ))}
  </ul>
  <span class="dock__sep" aria-hidden="true"></span>
  <button
    class="dock__item"
    type="button"
    data-theme-toggle
    data-label-dark={t('app.themeToDark')}
    data-label-light={t('app.themeToLight')}
    aria-label={t('app.themeToDark')}
    hidden
  >
    <Icon name="moon" class="dock__moon" />
    <Icon name="sun" class="dock__sun" />
  </button>
</nav>

<script>
  import { MODE_STORAGE_KEY } from '../../lib/theme';

  const root = document.documentElement;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => {
      const dark = root.dataset['mode'] === 'dark';
      button.setAttribute(
        'aria-label',
        (dark ? button.dataset['labelLight'] : button.dataset['labelDark']) ?? '',
      );
    };
    button.addEventListener('click', () => {
      const next = root.dataset['mode'] === 'dark' ? 'light' : 'dark';
      root.dataset['mode'] = next;
      try {
        localStorage.setItem(MODE_STORAGE_KEY, next);
      } catch {
        // Storage blocked: the choice applies to this page only.
      }
      sync();
    });
    sync();
    button.hidden = false;
  }

  // Hide the dock while the on-screen keyboard takes part of the viewport.
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const viewport = window.visualViewport;
  if (dock && viewport) {
    const update = () => {
      dock.dataset['keyboard'] = String(viewport.height < window.innerHeight * 0.75);
    };
    viewport.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .dock {
    position: fixed;
    inset-inline: 0;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
    z-index: 20;
    display: flex;
    gap: var(--space-1);
    align-items: center;
    width: max-content;
    max-width: calc(100% - 2 * var(--space-4));
    margin-inline: auto;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }

  .dock[data-keyboard='true'] {
    display: none;
  }

  .dock ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dock__item {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-btn);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .dock__item[hidden] {
    display: none;
  }

  .dock__item:hover {
    background: var(--surface-2);
  }

  .dock__item[aria-current='page'] {
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--accent);
  }

  .dock__item :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .dock__sep {
    align-self: stretch;
    width: 1px;
    margin-block: var(--space-2);
    background: var(--line);
  }

  :global([data-mode='dark']) .dock__item :global(.dock__moon),
  :global(:root:not([data-mode='dark'])) .dock__item :global(.dock__sun) {
    display: none;
  }

  @media (min-width: 48rem) {
    .dock {
      display: none;
    }
  }
</style>
