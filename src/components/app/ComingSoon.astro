---
/**
 * Placeholder for app sections built in later milestones: page heading + what the section will hold.
 * @prop title  Section name (the page h1).
 * @prop text   One line about what the section will show.
 * @prop icon   Section icon.
 */
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';
import { useTranslations } from '../../i18n';

interface Props {
  title: string;
  text: string;
  icon: IconName;
}

const { title, text, icon } = Astro.props;
const t = useTranslations(Astro.locals.profile?.locale);
---

<h1>{title}</h1>
<Card class="soon">
  <span class="soon__icon">
    <Icon name={icon} />
  </span>
  <div>
    <h2 class="soon__title">{t('app.soonTitle')}</h2>
    <p>{text}</p>
  </div>
</Card>

<style>
  .soon {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .soon__icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-btn);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .soon__title {
    margin-block-end: var(--space-1);
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    letter-spacing: 0;
    line-height: 1.3;
  }
</style>
