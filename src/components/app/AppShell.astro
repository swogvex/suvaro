---
/**
 * The signed-in app's frame, without data access: header, offline banner, optional banners, main, toasts,
 * the mobile dock and the global islands (movement editor, search, shortcuts). `AppLayout` fills it from the
 * database; `DemoLayout` from the demo's sample data.
 * @prop locale      Page language.
 * @prop section     Active section (header tabs and dock).
 * @prop bare        Hides tabs, dock and the global islands (onboarding).
 * @prop planDot     Unread budget alerts (dot on the Plan tab).
 * @prop avatar      The avatar in the header.
 * @prop flash       Toast text after a form post, if any.
 * @prop alert       Budget alert toast text, if any.
 * @prop context     What the editor and search need (null when `bare`).
 * @prop searchable  Settings pages offered by search.
 * Slot `banner`: shown above the content (e.g. "confirm your email", the demo notice).
 */
import AppHeader from './AppHeader.astro';
import Dock from './Dock.astro';
import Shortcuts from './Shortcuts.astro';
import Toaster from './Toaster.astro';
import MovementEditor from '../movements/MovementEditor.svelte';
import SearchDialog from '../movements/SearchDialog.svelte';
import Icon from '../ui/Icon.astro';
import { pickMessages, useTranslations, type Locale } from '../../i18n';
import type { AppSection } from '../../lib/app-nav';
import type { Avatar } from '../../lib/avatars';
import type { MovementsContext } from '../../lib/movements/page';

interface Props {
  locale: Locale;
  section: AppSection | 'settings';
  bare?: boolean;
  planDot?: boolean;
  avatar: Avatar;
  flash?: string | undefined;
  alert?: string | null;
  context: Omit<MovementsContext, 'weekStart'> | null;
  searchable: { label: string; href: string }[];
}

const {
  locale,
  section,
  bare = false,
  planDot = false,
  avatar,
  flash,
  alert = null,
  context,
  searchable,
} = Astro.props;
const t = useTranslations(locale);
const editorMessages = pickMessages(locale, ['editor.', 'movements.']);
const searchMessages = pickMessages(locale, ['search.', 'movements.']);
---

<div class:list={['app', bare && 'app--bare']}>
  <AppHeader locale={locale} section={section} nav={!bare} planDot={planDot} avatar={avatar} />

  <main id="main" class="container app__main">
    <p class="banner banner--offline" data-offline-banner hidden>
      <Icon name="wifi-off" />
      <span>{t('app.offline')}</span>
    </p>

    <slot name="banner" />
    <slot />
    <Toaster locale={locale} message={flash} alert={alert} />
  </main>

  {!bare && <Dock locale={locale} section={section} planDot={planDot} />}
  {context && (
    <>
      <MovementEditor
        client:load
        categories={context.categories}
        locale={locale}
        currency={context.currency}
        today={context.today}
        messages={editorMessages}
      />
      <SearchDialog
        client:idle
        categories={context.categories}
        locale={locale}
        currency={context.currency}
        settings={searchable}
        messages={searchMessages}
      />
      <Shortcuts locale={locale} />
    </>
  )}
</div>

<script>
  // Offline: show the banner and block saving (submit buttons) until the connection is back.
  const banner = document.querySelector<HTMLElement>('[data-offline-banner]');

  function sync() {
    const offline = !navigator.onLine;
    if (banner) banner.hidden = !offline;
    for (const button of document.querySelectorAll<HTMLButtonElement>('main button[type="submit"]')) {
      if (offline) {
        if (!button.disabled) button.dataset['offlineDisabled'] = 'true';
        button.disabled = true;
      } else if (button.dataset['offlineDisabled']) {
        delete button.dataset['offlineDisabled'];
        button.disabled = false;
      }
    }
  }

  window.addEventListener('online', sync);
  window.addEventListener('offline', sync);
  sync();
</script>

<style>
  .app__main {
    display: grid;
    gap: var(--space-6);
    align-content: start;
    padding-block: var(--space-4) 170px;
  }

  @media (min-width: 48rem) {
    .app__main {
      padding-block: var(--space-8) var(--space-12);
    }
  }

  .app--bare .app__main {
    padding-block-end: var(--space-12);
  }
</style>
