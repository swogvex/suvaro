---
/**
 * Sign in / create account page (`/sign-in`, `/es/acceso`). SSR, noindex. The language follows the page.
 * Split layout: reassurance HeroCard + the sign-in island.
 * @prop locale  Page language.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroCard from '../ui/HeroCard.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import SignInForm from './SignInForm.svelte';
import { dictionaries, otherLocale, useTranslations, type Locale, type UiKey } from '../../i18n';
import type { IconName } from '../../lib/icons';
import { homePath, legalPath, signInPaths } from '../../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);
const tOther = useTranslations(other);
const initialMode = Astro.url.searchParams.get('mode') === 'create' ? 'create' : 'sign-in';

const messages = Object.fromEntries(
  (Object.keys(dictionaries[locale]) as UiKey[])
    .filter((key) => key.startsWith('signIn.'))
    .map((key) => [key, t(key)]),
);

// The last two lines only show next to the form (wide screens), where the card is as tall as the form; on
// phones the card sits above the form and stays short.
const reassurance: { icon: IconName; text: string; wide?: boolean }[] = [
  { icon: 'key', text: t('signIn.heroLine1') },
  { icon: 'ban', text: t('signIn.heroLine2') },
  { icon: 'shield', text: t('signIn.heroLine3') },
  { icon: 'smartphone', text: t('signIn.heroLine4'), wide: true },
  { icon: 'gift', text: t('signIn.heroLine5'), wide: true },
];
const title = initialMode === 'create' ? t('signIn.titleCreate') : t('signIn.title');
---

<BaseLayout
  title={`${title} · Suvaro`}
  description={t('signIn.description')}
  locale={locale}
  alternates={signInPaths}
  noindex
>
  <div class="page">
    <header class="container top">
      <a class="brand" href={homePath(locale)} aria-label={t('nav.homeLabel')}>
        <Logo />
      </a>
      <a class="lang" href={signInPaths[other]} hreflang={other} lang={other}>
        {tOther('lang.name')}
      </a>
    </header>

    <main id="main" class="container split">
      <HeroCard as="section" class="intro" aria-labelledby="intro-title">
        <h1 id="intro-title">{t('signIn.heroTitle')}</h1>
        <ul class="intro__list">
          {reassurance.map(({ icon, text, wide }) => (
            <li class:list={[wide && 'intro__wide']}>
              <Icon name={icon} />
              <span>{text}</span>
            </li>
          ))}
        </ul>
        <p class="intro__note">{t('signIn.heroNote')}</p>
      </HeroCard>

      <section class="card panel" aria-label={title}>
        <noscript>
          <p class="noscript">{t('signIn.noScript')}</p>
        </noscript>
        <SignInForm
          client:load
          locale={locale}
          initialMode={initialMode}
          messages={messages}
          termsHref={legalPath('terms', locale)}
          privacyHref={legalPath('privacy', locale)}
        />
      </section>
    </main>

    <footer class="container bottom">
      <a href={homePath(locale)}>{t('signIn.back')}</a>
    </footer>
  </div>
</BaseLayout>

<style>
  /* Header, the two cards centered in the space left, footer. */
  .page {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100dvh - env(safe-area-inset-top, 0px));
  }

  .top,
  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-5);
  }

  .brand {
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius-s);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border-radius: var(--radius-btn);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }

  .lang:hover {
    background: var(--surface-2);
  }

  .split {
    display: grid;
    gap: var(--space-6);
    align-items: start;
    padding-block: var(--space-4) var(--space-8);
  }

  .intro {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
  }

  .intro__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .intro__list li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .intro__list :global(svg) {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
  }

  /* As tall as the tallest step (create account with its errors, Spanish), so the card never jumps when
     the mode changes, a box is ticked or an error appears. Measured (the tip hides while an error shows):
     633 px phone, 619 px desktop (create account + error, Spanish). */
  /* A grid so the form island (its wrapper is display: contents) stretches to the full height. */
  .panel {
    display: grid;
    min-height: 40rem;
    padding: var(--space-6);
  }

  .noscript {
    color: var(--ink-2);
  }

  .bottom {
    justify-content: center;
    padding-block-end: var(--space-8);
  }

  @media (min-width: 52rem) {
    .split {
      grid-template-columns: 1fr minmax(0, 28rem);
      align-content: center;
      align-items: stretch;
      padding-block-start: var(--space-8);
    }

    .panel {
      min-height: 39rem;
    }

    .intro {
      min-height: 100%;
      align-content: start;
      gap: var(--space-8);
      padding: var(--space-8);
    }

    /* Title, list, then the note at the bottom: the card is as tall as the form, so it never looks half
       empty. */
    .intro {
      grid-template-rows: auto auto 1fr;
    }

    .intro__list {
      gap: var(--space-8);
      font-size: 1.0625rem;
    }

    .intro__note {
      align-self: end;
      /* Clear of the decorative circle in the bottom corner. */
      max-width: calc(100% - 5rem);
      padding-block-start: var(--space-5);
      border-block-start: 1px solid var(--hero-line);
    }
  }

  @media (max-width: 51.99rem) {
    .intro__note {
      display: none;
    }
  }

  .intro__list .intro__wide {
    display: none;
  }

  @media (min-width: 52rem) {
    .intro__list .intro__wide {
      display: flex;
    }
  }
</style>
