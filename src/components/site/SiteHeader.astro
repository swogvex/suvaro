---
/**
 * Public header: logo · section links · language switch · Sign in.
 * @prop locale      Page language.
 * @prop alternates  This page in each language (for the language link).
 */
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import { otherLocale, useTranslations, type Locale } from '../../i18n';
import { homePath, signInPath, type Alternates } from '../../lib/routes';

interface Props {
  locale: Locale;
  alternates: Alternates;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);
const tOther = useTranslations(other);
const home = homePath(locale);
const onHome = Astro.url.pathname === home;
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
---

<header class="site-header container">
  <a class="site-header__brand" href={home} aria-label={t('nav.homeLabel')}>
    <Logo />
  </a>
  <nav class="site-header__nav" aria-label={t('nav.label')}>
    <ul>
      <li>
        <a href={anchor('how')}>{t('nav.how')}</a>
      </li>
      <li>
        <a href={anchor('data')}>{t('nav.data')}</a>
      </li>
      <li>
        <a href={anchor('faq')}>{t('nav.faq')}</a>
      </li>
    </ul>
  </nav>
  <div class="site-header__actions">
    <a class="site-header__lang" href={alternates[other]} hreflang={other} lang={other}>
      {tOther('lang.name')}
    </a>
    <Button href={signInPath(locale)} variant="secondary">
      {t('nav.signIn')}
    </Button>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .site-header__brand {
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius-s);
  }

  .site-header__nav {
    display: none;
    margin-inline-start: var(--space-4);
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a,
  .site-header__lang {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border-radius: var(--radius-btn);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }

  .site-header__nav a:hover,
  .site-header__lang:hover {
    background: var(--surface-2);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-inline-start: auto;
  }

  @media (min-width: 52rem) {
    .site-header__nav {
      display: block;
    }
  }

  @media (max-width: 23rem) {
    .site-header {
      gap: var(--space-2);
    }

    .site-header__lang {
      padding-inline: var(--space-2);
    }
  }
</style>
