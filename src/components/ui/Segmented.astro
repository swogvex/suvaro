---
/**
 * Segmented control: a native radio group (arrow keys work, no JS needed).
 * @prop legend      Group label (visually hidden unless `showLegend`).
 * @prop name        Radio name.
 * @prop options     `{ value, label, icon? }[]`.
 * @prop value       Checked value.
 * @prop showLegend  Shows the legend above the control.
 * @prop class       Extra classes on the fieldset. Other attributes pass through.
 */
import type { HTMLAttributes } from 'astro/types';
import type { IconName } from '../../lib/icons';
import Icon from './Icon.astro';

type Props = HTMLAttributes<'fieldset'> & {
  legend: string;
  name: string;
  options: readonly { value: string; label: string; icon?: IconName }[];
  value?: string;
  showLegend?: boolean;
};

const { legend, name, options, value, showLegend = false, class: className, ...rest } = Astro.props;
---

<fieldset class:list={['segmented-group', className]} {...rest}>
  <legend class:list={['field__label', !showLegend && 'visually-hidden']}>{legend}</legend>
  <div class="segmented">
    {options.map((option) => (
      <label class="segmented__item">
        <input type="radio" name={name} value={option.value} checked={option.value === value} />
        {option.icon && <Icon name={option.icon} />}
        <span>{option.label}</span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .segmented-group {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
  }
</style>
