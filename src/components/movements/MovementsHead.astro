---
/**
 * Movements page heading + the List · Calendar · Recurring (count) switch. List and Calendar links keep the
 * current filters; Recurring has none. A dot on Recurring says something is waiting for confirmation.
 * @prop view   Current view.
 * @prop query  Filter query to keep in the links (no leading "?").
 * @prop locale  Page language (default: the profile's).
 * @prop counts  Recurring templates and pending confirmations; read from the database when absent (the demo
 *               passes its own).
 */
import { useTranslations, type Locale } from '../../i18n';
import { db } from '../../lib/db';
import { countPending, countRecurring } from '../../lib/recurring/repo';
import { appPaths } from '../../lib/routes';
import Icon from '../ui/Icon.astro';

interface Props {
  view: 'list' | 'calendar' | 'recurring';
  query: string;
  locale?: Locale;
  counts?: { recurring: number; pending: number };
}

const { view, query, locale, counts } = Astro.props;
const { user, profile } = Astro.locals;
const t = useTranslations(locale ?? profile?.locale);
async function fromDatabase() {
  if (!user) throw new Error('Signed-in component');
  return Promise.all([countRecurring(db, user.id), countPending(db, user.id)]);
}
const [recurringCount, pendingCount] = counts ? [counts.recurring, counts.pending] : await fromDatabase();
const suffix = query ? `?${query}` : '';
const views = [
  { key: 'list', href: `${appPaths.movements}${suffix}`, label: t('movements.list'), icon: 'list' },
  {
    key: 'calendar',
    href: `${appPaths.calendar}${suffix}`,
    label: t('movements.calendar'),
    icon: 'calendar',
  },
  { key: 'recurring', href: appPaths.recurring, label: t('recurring.view'), icon: 'repeat' },
] as const;
---

<div class="head">
  <h1>{t('app.movements')}</h1>
  <nav aria-label={t('movements.views')}>
    <div class="segmented">
      {views.map(({ key, href, label, icon }) => (
        <a
          class="segmented__item"
          href={href}
          aria-current={view === key ? 'page' : undefined}
          data-view-link={key === 'recurring' ? undefined : ''}
        >
          <Icon name={icon} />
          {label}
          {key === 'recurring' && (
            <>
              <span class="count num">{recurringCount}</span>
              {pendingCount > 0 && (
                <span class="tab-dot">
                  <span class="visually-hidden">{t('recurring.pendingDot')}</span>
                </span>
              )}
            </>
          )}
        </a>
      ))}
    </div>
  </nav>
</div>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    justify-content: space-between;
  }

  /* Phones: the three views share the full width; icons go so "Recurrentes 12" still fits at 360 px. */
  @media (max-width: 30rem) {
    nav,
    .segmented {
      width: 100%;
    }

    .segmented__item {
      flex: 1 1 auto;
      padding-inline: var(--space-2);
    }

    .segmented__item :global(svg) {
      display: none;
    }
  }

  .count {
    padding: 0 var(--space-1);
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }
</style>
