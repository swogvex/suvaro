---
/**
 * Layout for signed-in pages (`/app/...`): header, offline banner, email-confirmation banner, main,
 * toasts and the mobile dock. noindex; language from the profile (the middleware sets `Astro.locals`).
 * @prop title    Page title (the document title; the page h1 says it on screen).
 * @prop section  Active section for the header tabs and the dock.
 * @prop bare     Hides the tabs and dock (onboarding).
 */
import AppHeader from '../components/app/AppHeader.astro';
import Dock from '../components/app/Dock.astro';
import Shortcuts from '../components/app/Shortcuts.astro';
import Toaster from '../components/app/Toaster.astro';
import MovementEditor from '../components/movements/MovementEditor.svelte';
import SearchDialog from '../components/movements/SearchDialog.svelte';
import Icon from '../components/ui/Icon.astro';
import BaseLayout from './BaseLayout.astro';
import { pickMessages, useTranslations } from '../i18n';
import type { AppSection } from '../lib/app-nav';
import { appPaths } from '../lib/routes';
import { settingsSections } from '../lib/settings/nav';
import { db } from '../lib/db';
import { describeError, logError } from '../lib/errors';
import { movementsContext } from '../lib/movements/page';
import { currentCycle, newAlertMessage } from '../lib/plan/notify';
import { markAlertsRead, unreadAlerts } from '../lib/plan/repo';
import { flashMessageKey } from '../lib/toast';

interface Props {
  title: string;
  section: AppSection | 'settings';
  bare?: boolean;
}

const { title, section, bare = false } = Astro.props;
const { profile, user } = Astro.locals;
if (!profile || !user) throw new Error('AppLayout needs a signed-in request');

const locale = profile.locale;
const t = useTranslations(locale);
const flash = flashMessageKey(Astro.url.searchParams.get('done'));
const showVerify = !user.emailVerified && Astro.url.pathname !== appPaths.verifyEmail;
// The editor and search are on every app page (dock "+", header "New", shortcuts), not during onboarding.
const context = bare ? null : await movementsContext(Astro.locals);
const editorMessages = pickMessages(locale, ['editor.', 'movements.']);
const searchMessages = pickMessages(locale, ['search.', 'movements.']);
const searchable = settingsSections.map((item) => ({ label: t(item.search), href: item.href }));

// Budget alerts: new ones show as a toast once per cycle; the Plan tab keeps a dot until Plan is opened.
let alert: string | null = null;
let planDot = false;
if (!bare) {
  try {
    alert = await newAlertMessage(db, user.id, profile);
    const cycle = currentCycle(profile);
    if (section === 'plan') await markAlertsRead(db, user.id, cycle);
    else planDot = (await unreadAlerts(db, user.id, cycle)) > 0;
  } catch (error) {
    await logError(Astro.url.pathname, 'BUDGET_ALERTS', describeError(error));
  }
}
---

<BaseLayout
  title={`${title} · Suvaro`}
  description={title}
  locale={locale}
  theme={{ mode: profile.mode, day: profile.themeDay, night: profile.themeNight }}
  noindex
>
  <div class:list={['app', bare && 'app--bare']}>
    <AppHeader locale={locale} section={section} nav={!bare} planDot={planDot} />

    <main id="main" class="container app__main">
      <p class="banner banner--offline" data-offline-banner hidden>
        <Icon name="wifi-off" />
        <span>{t('app.offline')}</span>
      </p>

      {showVerify && (
        <p class="banner banner--verify">
          <Icon name="mail" />
          <span>
            {t('app.verifyBanner')} <a href={appPaths.verifyEmail}>{t('app.verifyBannerAction')}</a>
          </span>
        </p>
      )}

      <slot />
      <Toaster locale={locale} message={flash && t(flash)} alert={alert} />
    </main>

    {!bare && <Dock locale={locale} section={section} planDot={planDot} />}
    {context && (
      <>
        <MovementEditor
          client:load
          categories={context.categories}
          locale={locale}
          currency={context.currency}
          today={context.today}
          messages={editorMessages}
        />
        <SearchDialog
          client:idle
          categories={context.categories}
          locale={locale}
          currency={context.currency}
          settings={searchable}
          messages={searchMessages}
        />
        <Shortcuts locale={locale} />
      </>
    )}
  </div>
</BaseLayout>

<script>
  // Offline: show the banner and block saving (submit buttons) until the connection is back.
  const banner = document.querySelector<HTMLElement>('[data-offline-banner]');

  function sync() {
    const offline = !navigator.onLine;
    if (banner) banner.hidden = !offline;
    for (const button of document.querySelectorAll<HTMLButtonElement>('main button[type="submit"]')) {
      if (offline) {
        if (!button.disabled) button.dataset['offlineDisabled'] = 'true';
        button.disabled = true;
      } else if (button.dataset['offlineDisabled']) {
        delete button.dataset['offlineDisabled'];
        button.disabled = false;
      }
    }
  }

  window.addEventListener('online', sync);
  window.addEventListener('offline', sync);
  sync();
</script>

<style>
  .app__main {
    display: grid;
    gap: var(--space-6);
    align-content: start;
    padding-block: var(--space-4) 170px;
  }

  .banner {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-m);
    color: var(--ink);
  }

  .banner :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }

  .banner--verify {
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .banner--verify :global(svg) {
    color: var(--accent);
  }

  .banner--offline {
    background: var(--ink);
    color: var(--bg);
  }

  .banner[hidden] {
    display: none;
  }

  @media (min-width: 48rem) {
    .app__main {
      padding-block: var(--space-8) var(--space-12);
    }
  }

  .app--bare .app__main {
    padding-block-end: var(--space-12);
  }
</style>
