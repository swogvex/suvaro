---
/**
 * Root document for every page.
 * @prop title        Page title (already translated).
 * @prop description  Meta description (already translated).
 * @prop locale       Page language, `en` or `es`.
 * @prop alternates   Path of this page in each locale, for canonical + hreflang. Omit on pages without translations.
 * @prop noindex      Adds `noindex` for app, demo, sign-in and error pages.
 */
import { Font } from 'astro:assets';
import '../styles/global.css';
import { defaultLocale, useTranslations, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
}

const { title, description, locale, alternates, noindex = false } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const alternateLinks = Object.entries(alternates ?? {}).map(([lang, path]) => ({
  lang,
  href: new URL(path, site).href,
}));
const xDefault = alternates?.[defaultLocale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {alternateLinks.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, site).href} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <Font cssVariable="--font-unbounded" preload />
    <Font cssVariable="--font-gabarito" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('a11y.skipToContent')}
    </a>
    <slot />
  </body>
</html>
