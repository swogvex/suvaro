---
/**
 * 404 "Off the trail" (approved variant 1). Rendered on demand so the language follows the path:
 * Spanish under /es, English elsewhere. Copy from `src/content/pages/{en,es}/404.md`.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Logo from '../components/ui/Logo.astro';
import { otherLocale, useTranslations } from '../i18n';
import { appPaths, homePath, localeFromPath } from '../lib/routes';

export const prerender = false;

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const other = otherLocale(locale);
const tOther = useTranslations(other);
const entry = await getEntry('pages', `${locale}/404`);
if (!entry) throw new Error(`Missing 404 content for ${locale}`);
const { title, lead, primary, secondary } = entry.data;
---

<BaseLayout title={`${title} · Suvaro`} description={lead} locale={locale} noindex>
  <div class="page">
    <header class="container top">
      <a class="brand" href={homePath(locale)} aria-label={t('nav.homeLabel')}>
        <Logo />
      </a>
    </header>

    <main id="main" class="container nf">
      <svg class="scene" viewBox="0 0 800 380" role="img" aria-label={t('notFound.sceneLabel')}>
        <ellipse class="f-soft" cx="400" cy="196" rx="330" ry="46"></ellipse>
        <g class="f-accent grass">
          <path d="M150 196c2-14 6-20 10-24-1 8 0 16-2 24z"></path>
          <path d="M162 196c0-10 3-16 7-18 0 6-1 12-3 18z"></path>
          <path d="M640 194c2-14 6-20 10-24-1 8 0 16-2 24z"></path>
          <path d="M652 194c0-10 3-16 7-18 0 6-1 12-3 18z"></path>
          <path d="M520 172c2-12 5-17 9-20-1 7 0 14-2 20z"></path>
          <path d="M262 176c1-10 4-14 7-16 0 5-1 11-2 16z"></path>
        </g>
        <g class="f-coral">
          <polygon points="220,380 580,380 556,332 244,332"></polygon>
          <polygon points="247,327 553,327 532,288 268,288" opacity=".92"></polygon>
          <polygon points="271,283 529,283 512,250 288,250" opacity=".84"></polygon>
          <polygon points="291,245 509,245 494,218 306,218" opacity=".76"></polygon>
          <polygon points="309,213 466,210 478,192 322,196" opacity=".66"></polygon>
        </g>
        <g class="s-coral" stroke-width="2" stroke-linecap="round" opacity=".7">
          <path d="M480 190l14-8M484 196l12 2"></path>
        </g>
        <rect class="f-coral" x="598" y="96" width="8" height="100" rx="3"></rect>
        <path class="sign" d="M556 104h84l18 16-18 16h-84z" stroke-width="2.5" stroke-linejoin="round"></path>
        <text class="sign-text" x="600" y="126" text-anchor="middle">
          {t('notFound.sign')}
        </text>
        <g class="f-butter">
          <rect x="190" y="70" width="12" height="12" rx="2"></rect>
          <rect x="684" y="54" width="8" height="8" rx="2"></rect>
        </g>
      </svg>
      <p class="code">404</p>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      <div class="actions">
        <Button href={appPaths.app} variant="primary" size="lg">
          {primary}
        </Button>
        <Button href={homePath(locale)} variant="secondary" size="lg">
          {secondary}
        </Button>
      </div>
    </main>

    <footer class="bottom">
      <a href={homePath(other)} lang={other} hreflang={other}>
        {tOther('lang.noticeLink')}
      </a>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .top {
    padding-block-start: var(--space-5);
  }

  .brand {
    display: inline-flex;
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius-s);
  }

  .nf {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-12);
    text-align: center;
  }

  .scene {
    width: 100%;
    max-width: 45rem;
    height: auto;
  }

  .f-soft {
    fill: var(--accent-soft);
  }

  .f-accent {
    fill: var(--accent);
  }

  .grass {
    opacity: 0.75;
  }

  .f-coral {
    fill: var(--accent-2);
  }

  .s-coral {
    stroke: var(--accent-2);
  }

  .f-butter {
    fill: var(--cat-4);
  }

  .sign {
    fill: var(--surface);
    stroke: var(--accent-2);
  }

  .sign-text {
    fill: var(--ink);
    font: 700 18px var(--font-ui);
  }

  .code {
    color: var(--ink-2);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.3em;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
  }

  .lead {
    max-width: 30rem;
    color: var(--ink-2);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .bottom {
    padding: 0 var(--space-6) var(--space-6);
    text-align: center;
    font-size: 0.875rem;
  }

  .bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
