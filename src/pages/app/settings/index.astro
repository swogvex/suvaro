---
/**
 * Settings home (`/app/settings`, opened from the avatar): every section with a one-line summary.
 * On phones this is the list of the list → detail pattern; on desktop the same cards in two columns.
 */
import Icon from '../../../components/ui/Icon.astro';
import AppLayout from '../../../layouts/AppLayout.astro';
import { useTranslations } from '../../../i18n';
import { settingsSections } from '../../../lib/settings/nav';

const { profile } = Astro.locals;
if (!profile) throw new Error('Signed-in page');
const t = useTranslations(profile.locale);
---

<AppLayout title={t('settings.title')} section="settings">
  <h1>{t('settings.title')}</h1>
  <ul class="sections">
    {settingsSections.map((item) => (
      <li>
        <a class="card section-link" href={item.href}>
          <span class="section-link__icon">
            <Icon name={item.icon} />
          </span>
          <span class="section-link__text">
            <span class="section-link__title">{t(item.title)}</span>
            <span class="section-link__lead">{t(item.lead)}</span>
          </span>
          <Icon name="chevron-right" class="section-link__chevron" />
        </a>
      </li>
    ))}
  </ul>
</AppLayout>

<style>
  .sections {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section-link {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    height: 100%;
    padding: var(--space-4) var(--space-5);
    color: var(--ink);
    text-decoration: none;
  }

  .section-link:hover {
    border-color: var(--accent);
  }

  .section-link__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-btn);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  :global([data-mode='dark']) .section-link__icon {
    color: var(--accent);
  }

  .section-link__icon :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
  }

  .section-link__text {
    display: grid;
    flex: 1;
    gap: var(--space-1);
  }

  .section-link__title {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .section-link__lead {
    color: var(--ink-2);
  }

  .section-link :global(.section-link__chevron) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--ink-2);
  }

  @media (min-width: 48rem) {
    .sections {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
</style>
