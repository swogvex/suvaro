---
import ComingSoon from '../../components/app/ComingSoon.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.locals.profile?.locale);
---

<AppLayout title={t('app.plan')} section="plan">
  <ComingSoon title={t('app.plan')} text={t('app.soonPlan')} icon="target" />
</AppLayout>
