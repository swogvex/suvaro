---
/**
 * Plan (`/app/plan`): savings goals with contributions, and monthly budgets for the current cycle.
 * Loaded on the server, so the first paint already has the numbers. Opening it reads the cycle's budget
 * alerts (the layout clears the dot on the Plan tab).
 */
import PlanDashboard from '../../components/plan/PlanDashboard.svelte';
import AppLayout from '../../layouts/AppLayout.astro';
import { pickMessages, useTranslations } from '../../i18n';
import { db } from '../../lib/db';
import { movementsContext } from '../../lib/movements/page';
import { currentCycle } from '../../lib/plan/notify';
import { loadPlan } from '../../lib/plan/repo';

const { user, profile } = Astro.locals;
if (!user || !profile) throw new Error('Signed-in page');
const context = await movementsContext(Astro.locals);
const t = useTranslations(context.locale);
const initial = await loadPlan(db, user.id, currentCycle(profile));
const messages = pickMessages(context.locale, ['plan.', 'app.plan', 'movements.noCategory']);
---

<AppLayout title={t('app.plan')} section="plan">
  <PlanDashboard
    client:load
    initial={initial}
    startDay={profile.cycleStartDay}
    today={context.today}
    categories={context.categories}
    locale={context.locale}
    currency={context.currency}
    messages={messages}
  />
</AppLayout>
